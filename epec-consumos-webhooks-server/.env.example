EPEC_API_KEY={epec_api_key}
EPEC_API_BASE_URL={epec_api_base_url}
SMTP_USER={smtp_user}
SMTP_APP_PASSWORD={smtp_app_password}
# Keys the hash of the documento in logs; required when NODE_ENV=production
LOG_HASH_SECRET={log_hash_secret}

# Server Configuration (Railway sets PORT automatically)
PORT=3000
