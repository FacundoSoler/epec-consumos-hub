{
    "manifest_version": 3,
    "name": "EPEC Consumption Checker",
    "version": "1.0",
    "permissions": [
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://www.epec.com.ar/*",
        "http://localhost:3000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    }
}